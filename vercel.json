{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/barber-uz run build",
  "outputDirectory": "artifacts/barber-uz/dist/public",
  "env": {
    "PORT": "5173",
    "BASE_PATH": "/"
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://barber-uz-clq6.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://barber-uz-clq6.onrender.com/api/:path*"
    }
  ]
}
