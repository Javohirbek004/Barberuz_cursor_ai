{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/barber-uz run build",
  "outputDirectory": "artifacts/barber-uz/dist/public",
  "env": {
    "PORT": "5173",
    "BASE_PATH": "/"
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://workspaceapi-server-production-c5e26df8.up.railway.app/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://workspaceapi-server-production-c5e26df8.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
