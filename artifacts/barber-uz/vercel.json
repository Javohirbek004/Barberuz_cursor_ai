{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "env": {
    "PORT": "5173",
    "BASE_PATH": "/"
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://api.zumio.uz/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.zumio.uz/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
