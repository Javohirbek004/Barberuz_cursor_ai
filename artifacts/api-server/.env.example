PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Required. At least 32 random characters. Never commit the real value.
JWT_SECRET=change_me_generate_32_plus_random_chars

# Required. Changing this invalidates existing password hashes.
PASSWORD_SALT=change_me_unique_password_salt

# Required. Shared secret for POST /api/auth/telegram-verify (not a BotFather token).
TELEGRAM_BOT_SECRET=change_me_unique_telegram_bot_secret

# Required in production for /api/v1 admin routes.
ADMIN_SECRET=change_me_unique_admin_secret

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
APP_URL=http://localhost:5173
FEEDBACKS_BOT=
ADMIN_TELEGRAM_ID=
